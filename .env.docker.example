# 复制为仓库根目录的 .env 后填写。真实密钥和密码不得提交到仓库。
DEEPSEEK_API_KEY=replace-with-your-own-key

# 使用至少 32 位、仅包含字母、数字、下划线和连字符的 URL 安全密码。
# Compose 会将同一个值同时用于 PostgreSQL 和后端数据库连接。
CODING_AGENT_POSTGRES_PASSWORD=replace_with_a_32_char_url_safe_password

# 后端只能访问这个宿主机目录。Windows 推荐使用正斜杠，例如 E:/code。
CODING_AGENT_WORKSPACE_PATH=E:/code

# Web 仅监听宿主机回环地址。
CODING_AGENT_HTTP_PORT=8080

# Linux 可改成当前用户的 id -u / id -g；Docker Desktop 通常无需修改。
CODING_AGENT_UID=1000
CODING_AGENT_GID=1000

CODING_AGENT_BASE_URL=https://api.deepseek.com
CODING_AGENT_MODEL=deepseek-v4-flash

# Docker Hub 受限时，可填写已验证的镜像代理地址；默认使用官方 Python 镜像。
# CODING_AGENT_PYTHON_IMAGE=registry.example.com/library/python:3.12-slim-bookworm
# CODING_AGENT_NODE_IMAGE=registry.example.com/library/node:22-alpine
# CODING_AGENT_NGINX_IMAGE=registry.example.com/library/nginx:1.30-alpine
# CODING_AGENT_POSTGRES_IMAGE=registry.example.com/pgvector/pgvector:0.8.6-pg17-bookworm
