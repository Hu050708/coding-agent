# Local template only. Never commit a real key.
DEEPSEEK_API_KEY=replace-with-your-own-key

# The Web UI may only operate on workspaces below this existing directory.
CODING_AGENT_ALLOWED_ROOT=E:\code

# Optional private diagnostic-trace directory. PostgreSQL, not this directory,
# stores Web workspaces, conversations, messages, events, approvals, and memory.
# It must remain outside CODING_AGENT_ALLOWED_ROOT and defaults to
# %LOCALAPPDATA%\Coding Agent.
# CODING_AGENT_DATA_DIR=C:\path\to\private\coding-agent-data

# Keep this aligned with frontend/vite.config.ts unless both are changed.
CODING_AGENT_WEB_PORT=8000

# Web requires its dedicated loopback-only PostgreSQL service; CLI ignores both
# values. Use the same strong local password below and URL-encode it in the URL.
# Start PostgreSQL before the API:
# docker compose --env-file .env -f deploy/compose.yml up -d
CODING_AGENT_POSTGRES_PASSWORD=replace-with-a-strong-local-password
CODING_AGENT_DATABASE_URL=postgresql+psycopg://coding_agent:replace-with-a-strong-local-password@127.0.0.1:5434/coding_agent

# Official DeepSeek Chat Completions endpoint and selected model.
CODING_AGENT_BASE_URL=https://api.deepseek.com
CODING_AGENT_MODEL=deepseek-v4-flash
