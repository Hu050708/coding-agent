# Local template only. Never commit a real key.
DEEPSEEK_API_KEY=replace-with-your-own-key

# The Web UI may only operate on workspaces below this existing directory.
CLEARLOOP_ALLOWED_ROOT=E:\code

# Optional. Must remain outside CLEARLOOP_ALLOWED_ROOT.
# Project memory defaults to %LOCALAPPDATA%\ClearLoop.
# CLEARLOOP_DATA_DIR=C:\path\to\private\clearloop-data

# Keep this aligned with frontend/vite.config.ts unless both are changed.
CLEARLOOP_WEB_PORT=8000

# Official DeepSeek Chat Completions endpoint and selected model.
CLEARLOOP_BASE_URL=https://api.deepseek.com
CLEARLOOP_MODEL=deepseek-v4-flash
