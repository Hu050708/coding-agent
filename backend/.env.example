# Local template only. Never commit a real key.
DEEPSEEK_API_KEY=replace-with-your-own-key

# The Web UI may only operate on workspaces below this existing directory.
CODING_AGENT_ALLOWED_ROOT=E:\code

# Optional. Must remain outside CODING_AGENT_ALLOWED_ROOT.
# Project memory defaults to %LOCALAPPDATA%\Coding Agent.
# CODING_AGENT_DATA_DIR=C:\path\to\private\coding-agent-data

# Keep this aligned with frontend/vite.config.ts unless both are changed.
CODING_AGENT_WEB_PORT=8000

# Official DeepSeek Chat Completions endpoint and selected model.
CODING_AGENT_BASE_URL=https://api.deepseek.com
CODING_AGENT_MODEL=deepseek-v4-flash
