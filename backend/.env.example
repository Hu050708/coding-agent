# 仅供本地使用的模板，绝不要提交真实密钥。
DEEPSEEK_API_KEY=replace-with-your-own-key

# Web UI 只能操作此现有目录下的工作区。
CODING_AGENT_ALLOWED_ROOT=E:\code

# 可选的私有诊断跟踪目录。Web 工作区、会话、消息、事件、审批和记忆由 PostgreSQL
# 保存，而不是存放在此目录中。该目录必须位于 CODING_AGENT_ALLOWED_ROOT 之外，
# 默认值为 %LOCALAPPDATA%\Coding Agent。
# CODING_AGENT_DATA_DIR=C:\path\to\private\coding-agent-data

# 除非同时修改两处，否则应与 frontend/vite.config.ts 保持一致。
CODING_AGENT_WEB_PORT=8000

# Web 服务强制使用专用且仅监听回环地址的 PostgreSQL 服务；CLI 会忽略以下两个值。
# 请在下方使用同一个高强度本地密码，并在 URL 中对密码进行编码。
# 启动 API 前先启动 PostgreSQL：
# docker compose --env-file .env -f deploy/compose.yml up -d
CODING_AGENT_POSTGRES_PASSWORD=replace-with-a-strong-local-password
CODING_AGENT_DATABASE_URL=postgresql+psycopg://coding_agent:replace-with-a-strong-local-password@127.0.0.1:5434/coding_agent

# DeepSeek 官方 Chat Completions 端点和选用模型。
CODING_AGENT_BASE_URL=https://api.deepseek.com
CODING_AGENT_MODEL=deepseek-v4-flash
